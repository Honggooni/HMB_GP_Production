  "settings": [
    {
      "description": "HMB Seedance Generation authenticates through the FN AI Broker's one-time browser authorization. Provider API keys remain exclusively on the Broker server. The client performs no secondary usage recording; the Broker is the sole usage, quota, and accounting authority. The node exposes no provider-key input, registration state, quota, or reset data. The permanent Broker access token is protected with Windows DPAPI and never stored in node parameters, outputs, logs, manifests, or release archives. Local reference videos may still use separately scoped Griptape Cloud or least-privilege Volcengine TOS storage credentials.",
      "category": "app_events.on_app_initialization_complete",
      "contents": {
