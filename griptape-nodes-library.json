  "widgets": [
    {
      "name": "HMBAgentLibraryWidget",
      "path": "widgets/HMBAgentLibraryWidget.js",
      "description": "Compact HMBAgentLibrary header with an explicit standalone Only mode and a backend-verified selector containing only same-flow Prompt-owned Shots; native Agent controls and output behavior remain unchanged."
    },
    {
      "name": "HMBImageAssetLibraryWidget",
      "path": "widgets/HMBImageAssetLibraryWidget.js",
      "description": "Project catalog and image asset browser backed by the canonical _hmb_common.py taxonomy, with compact Project Set/reload icons, manifest-backed Add registration that copies external media directly into a selected child Asset Folder, explicit registered/unregistered thumbnail footers, and a compact draggable @image1-@image50 generator-order tray."
    },
    {
      "name": "HMBPromptLibraryScopedBindingWidget",
      "path": "widgets/HMBPromptLibraryScopedBindingWidget.js",
      "description": "Goal-first Prompt dashboard where verified Asset Sub Type remains registered and Target stays editable from a Main-Type default. The image + button is locked only while IMAGE_ASSET_IN is connected and automatically returns after disconnect; video, Picker, Color Pick, VIDEO VFX, and Keep Out data remain optional without downstream prerequisites."
    },
    {
      "name": "HMBSeedanceGenerationWidget",
      "path": "widgets/HMBSeedanceGenerationWidget.js",
      "description": "Compact HMB Seedance Generation header placed directly above Model. Only preserves and exposes task-specific manual image, video, audio, and frame references; each numbered Shot temporarily forces Reference to Video and resolves only exact same-Shot ImageAsset and VideoPicker publications without deleting the authored Only values."
    },
    {
      "name": "HMBVideoPickerCommandBridgeWidget",
      "path": "widgets/HMBVideoPickerCommandBridgeWidget_v032.js",
      "description": "Hidden minimal JSON command transport for HMBVideoPickerLibrary; execution commands remain separate from persistent dashboard state."
    },
    {
      "name": "HMBVideoPickerLibraryWidget",
      "path": "widgets/HMBVideoPickerLibraryWidget_v032.js",
      "description": "Maya playblast viewport with ImageAsset-synchronized one-to-five Shot video workspaces. Each Shot owns at most ten imported or generated assets; the expanded view shows only the active Shot, and only that Shot's ordered selected subset drives PICKER_OUT and VIDEO_OUT. The compact loader renders actual owned cards only, reuses one on-demand player, and sizes itself to visible rows. Maya scene changes preserve durable video history and stable video UIDs."
    }
